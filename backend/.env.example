# Copy this file to ".env" and fill in real values.

# Leave DATABASE_URL unset to use a local SQLite file (easiest for a demo),
# or point it at PostgreSQL like the line below:
# DATABASE_URL=postgresql://localhost:5432/deepfake_challenge

# A long random string used to sign login tokens.
JWT_SECRET_KEY=please-change-this-to-a-long-random-string
